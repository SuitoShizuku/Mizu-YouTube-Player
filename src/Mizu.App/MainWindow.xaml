<Window x:Class="Mizu.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mizu YT Player — Phase 1"
 Width="1280" Height="850" MinWidth="900" MinHeight="650" Background="#0D1724" Foreground="#EDF4FA"
 FontFamily="Yu Gothic UI" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#101F30" Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Mizu" Foreground="#77D9EC" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="YT PLAYER" FontSize="11" Margin="10,0,22,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="YouTubeを、そのまま。" VerticalAlignment="Center" Foreground="#A7BACB"/>
        <TextBlock Grid.Column="2" Text="PHASE 1 · PLAYER" VerticalAlignment="Center" Foreground="#A7BACB" FontSize="11"/>
      </Grid>
    </Border>
    <Grid DockPanel.Dock="Top" Margin="10,5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BackButton" Content="←" ToolTip="戻る" AutomationProperties.Name="戻る" Click="Back_Click" IsEnabled="False"/>
        <Button x:Name="ForwardButton" Content="→" ToolTip="進む" AutomationProperties.Name="進む" Click="Forward_Click" IsEnabled="False"/>
        <Button Content="再読み込み" Click="Reload_Click"/>
        <Button Content="YouTube" Click="Home_Click"/>
      </StackPanel>
      <TextBox x:Name="AddressBox" Grid.Column="1" Margin="8,3" Text="https://www.youtube.com/" KeyDown="Address_KeyDown" AutomationProperties.Name="URL"/>
      <Button Grid.Column="2" Content="開く" Click="Go_Click"/>
    </Grid>
    <WrapPanel DockPanel.Dock="Top" Margin="16,4,16,8">
      <CheckBox x:Name="AdBlockToggle" Content="広告ブロック（実験的）" Foreground="#EDF4FA" Click="AdBlock_Click" VerticalAlignment="Center"
                ToolTip="一部の広告通信とページ内広告枠を対象にします。動画広告の完全除去は未対応です。切り替え後はページを再読み込みしてください。"/>
      <TextBlock x:Name="AdBlockText" Margin="15,0,0,0" Foreground="#A7BACB" VerticalAlignment="Center"/>
    </WrapPanel>
    <Expander DockPanel.Dock="Top" Header="音声経路の診断 / Phase 1" Margin="16,0,16,8" Foreground="#D5E7F4" IsExpanded="True">
      <StackPanel Margin="0,8,0,0">
        <WrapPanel>
          <CheckBox x:Name="CaptureToggle" Content="PCM取得のみ（スピーカーへ出力しません）" Foreground="#EDF4FA" VerticalAlignment="Center" Margin="0,0,15,0" Click="Capture_Click"/>
          <Button Content="診断用テスト音を開く" Click="TestTone_Click"/>
          <Button Content="確認手順" Click="Help_Click"/>
        </WrapPanel>
        <TextBlock x:Name="ModeText" Text="通常再生：YouTubeの音声をブラウザから出力します。VSTは未実装です。" Margin="0,6" TextWrapping="Wrap" Foreground="#A7BACB"/>
        <TextBlock x:Name="ProbeText" FontFamily="Consolas" Foreground="#77D9EC" Text="PCM診断：OFF"/>
      </StackPanel>
    </Expander>
    <Border DockPanel.Dock="Bottom" Padding="14,8" Background="#101F30">
      <TextBlock x:Name="StatusText" Text="起動中…" TextWrapping="Wrap" Foreground="#B7CADA"/>
    </Border>
    <ContentControl x:Name="BrowserContainer"/>
  </DockPanel>
</Window>
