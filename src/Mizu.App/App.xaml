<Application x:Class="Mizu.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="#213244"/><Setter Property="Foreground" Value="#F0F6FC"/>
      <Setter Property="BorderBrush" Value="#45617C"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#142131"/>
      <Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="BorderBrush" Value="#45617C"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Application.Resources>
</Application>
